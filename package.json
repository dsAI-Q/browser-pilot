{
  "name": "@dsai-q/browser-pilot",
  "version": "0.5.2",
  "description": "Agent-friendly browser control for DSH: attach to the Chrome you are already using, snapshot pages into ref handles, assert outcomes, and only touch credentials when a site really needs them. Opt-in zero-retention mode.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "browser-pilot": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/plugin.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "locale",
    "docs",
    "examples",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "node test/smoke.mjs"
  },
  "keywords": [
    "playwright",
    "browser-automation",
    "agent",
    "cdp",
    "privacy",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/dsAI-Q/browser-pilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsAI-Q/browser-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/dsAI-Q/browser-pilot/issues"
  },
  "author": "dsAI-Q",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "playwright-core": "^1.48.0"
  }
}
