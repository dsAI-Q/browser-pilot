{
  "name": "browser-pilot",
  "version": "0.3.0",
  "description": "Agent-friendly controlled browser automation. Zero retention by default: never writes URLs or credentials to disk.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "browser-pilot": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/plugin.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "locale",
    "docs",
    "examples",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "node test/smoke.mjs"
  },
  "keywords": [
    "playwright",
    "browser-automation",
    "agent",
    "privacy",
    "zero-retention",
    "dsh-plugin"
  ],
  "dependencies": {
    "playwright-core": "^1.48.0"
  }
}
